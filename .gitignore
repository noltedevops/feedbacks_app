# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/


scratch/

# Vendored Node.js toolchain - 181MB of downloadable runtime, not source.
# Recreate with: python install_node.py
# Root-anchored so it can never swallow a source directory named "node".
/node/

# Node - frontend/.gitignore already covers frontend/; these are the root-level
# safety net for anything run from the repo root.
node_modules/
dist/
*.log

# Environment / secrets
.env
.env.*
# ...but the template carries no real values and must be committed.
!.env.example

# Local SQLite fallback, created when the Postgres connection fails
*.db

# Ad-hoc local probe: connects to the dev database as a named role to check that
# login works. Throwaway despite the name - it is not a test and nothing runs it.
# It carries a real database username, so it should never reach the remote.
user_test.py

# Database dumps - contain the users table, never commit
backup-*.sql

# Generated slide decks - deliverables built from a script, not source. Kept
# wherever they are needed rather than tracked here.
*.pptx

# Agent tooling
.claude/

# Editors
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
