# Copy to .env and fill in. .env is gitignored; this file is not, so it must never
# carry a real value.

# --- Application ---
DATABASE_URL=postgresql://postgres:CHANGEME@localhost:5432/nolte_geoservices

# Signs session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Leave unset only for throwaway local runs: the server then uses a random key and
# every session ends when it restarts. Changing it signs everyone out.
AUTH_SECRET=

# Password given to the default accounts, and only when the users table is seeded
# empty. Has no effect once accounts exist; use manage_access.py after that.
SEED_PASSWORD=

# --- docker-compose ---
# POSTGRES_PASSWORD is applied only when the postgres_data volume is first created.
# On an existing volume, rotate with:
#   ALTER USER postgres WITH PASSWORD '...';
# and update DATABASE_URL above to match.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=nolte_geoservices

# Applied only when the pgadmin_data volume is first created. On an existing volume,
# change it from inside pgAdmin instead.
PGADMIN_DEFAULT_EMAIL=you@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGEME
